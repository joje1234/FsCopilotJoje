@echo off
setlocal
set "FSC_EFB_HELPER_DIR=%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { $destination=if($env:FSC_EFB_DIAGNOSTICS_DESTINATION){$env:FSC_EFB_DIAGNOSTICS_DESTINATION}else{[Environment]::GetFolderPath('Desktop')}; $report=Join-Path $destination ('FsCopilot-diagnostics-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+[Guid]::NewGuid().ToString('N').Substring(0,6)); New-Item -ItemType Directory -Path $report -Force | Out-Null; $sources=New-Object 'System.Collections.Generic.List[string]'; function Save-Log([string]$source,[string]$name){if(Test-Path -LiteralPath $source -PathType Leaf){Copy-Item -LiteralPath $source -Destination (Join-Path $report $name); $sources.Add($source)}}; $logs=Join-Path $env:LOCALAPPDATA 'FsCopilot\Efb\Logs'; if(Test-Path -LiteralPath $logs){Get-ChildItem -LiteralPath $logs -Filter 'helper-*.log' -File | Sort-Object LastWriteTime -Descending | Select-Object -First 3 | ForEach-Object {Save-Log $_.FullName $_.Name}; Save-Log (Join-Path $logs 'latest-log.txt') 'latest-log.txt'}; Save-Log (Join-Path $env:FSC_EFB_HELPER_DIR 'log') 'legacy-helper.log'; $roots=@((Join-Path $env:APPDATA 'Microsoft Flight Simulator 2024\WASM'),(Join-Path $env:LOCALAPPDATA 'Microsoft Flight Simulator 2024\WASM'),(Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.Limitless_8wekyb3d8bbwe\LocalState\WASM'),(Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.FlightSimulator_8wekyb3d8bbwe\LocalState\WASM')); $nativeIndex=0; foreach($root in $roots){if(Test-Path -LiteralPath $root){Get-ChildItem -LiteralPath $root -Filter 'controls-test.log' -Recurse -File -ErrorAction SilentlyContinue | Where-Object {$_.FullName -like '*\fscopilot-controls-test\work\controls-test.log'} | ForEach-Object {$nativeIndex++; Save-Log $_.FullName ('native-'+$nativeIndex+'.log')}}}; $info=@('Collected: '+[DateTimeOffset]::Now.ToString('o'),'Helper folder: '+$env:FSC_EFB_HELPER_DIR,'Native logs found: '+$nativeIndex,'Sources:')+$sources.ToArray(); $info | Set-Content -LiteralPath (Join-Path $report 'sources.txt') -Encoding UTF8; $zip=$report+'.zip'; Compress-Archive -LiteralPath $report -DestinationPath $zip; Write-Host ('Diagnostics ZIP: '+$zip); Write-Host 'Only logs and source-path metadata were collected. Saved learning/settings were not copied.' } catch {Write-Host ('Collection failed: '+$_.Exception.Message); exit 1}; if(-not $env:FSC_EFB_DIAGNOSTICS_DESTINATION){Read-Host 'Press Enter to close' | Out-Null}"
set "FSC_EFB_COLLECT_EXIT=%ERRORLEVEL%"
endlocal & exit /b %FSC_EFB_COLLECT_EXIT%
